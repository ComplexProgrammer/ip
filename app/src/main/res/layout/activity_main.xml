<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/globe"
    tools:context=".MainActivity">
    <androidx.cardview.widget.CardView
        android:id="@+id/CardView1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#0000ffff"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="true">
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:layout_marginEnd="5dp"
            >

            <TableRow
                android:gravity="start">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:counterEnabled="true"
                    app:counterMaxLength="15"
                    android:layout_column="0"
                    android:layout_weight="1"
                    app:counterTextAppearance="@style/counterText"
                    app:counterOverflowTextAppearance="@style/counterOverride">
                    <EditText
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:ems="10"
                        android:id="@+id/_ip"
                        android:hint="@string/ip" />
                </com.google.android.material.textfield.TextInputLayout>
                <Button
                    android:background="@drawable/blue_button"
                    android:textColor="#ffff"
                    android:drawableStart="@drawable/ic_baseline_find_replace_24"
                    android:id="@+id/ip_lookup"
                    android:text="@string/ip_lookup"/>
                <Button
                    android:background="@drawable/green_button"
                    android:textColor="#ffff"
                    android:drawableStart="@drawable/ic_baseline_my_location_24"
                    android:layout_marginStart="5dp"
                    android:id="@+id/my_ip"
                    android:text="@string/my_ip"/>

            </TableRow>
            <TableRow
                android:gravity="end"
                android:visibility="gone"
                android:id="@+id/map_tab">
                <Button
                    android:background="@drawable/red_button"
                    android:textColor="#ffff"
                    android:drawableStart="@drawable/ic_baseline_map_24"
                    android:layout_column="0"
                    android:layout_width="match_parent"
                    android:id="@+id/map"
                    android:text="@string/map"/>
            </TableRow>
        </TableLayout>
    </androidx.cardview.widget.CardView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_below="@+id/CardView1"
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="150dp">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#fff"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="true">
                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="15dp">
                    <TableRow
                        android:id="@+id/reason_tab"
                        android:visibility="gone"
                        android:background="#f0f0f0"
                        android:layout_margin="1dp"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_column="0"
                            />

                        <TextView
                            android:textSize="16dp"
                            android:textColor="@color/Red"
                            android:id="@+id/reason"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="2"
                            android:layout_weight="1" />
                    </TableRow>
                    <TableRow
                        android:id="@+id/ip_tab"
                        android:background="#f0f0f0"
                        android:layout_margin="1dp"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_column="0"
                            android:text="@string/ip" />
                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:layout_column="1"
                            />
                        <TextView
                            android:id="@+id/ip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="2"
                            android:layout_weight="1" />
                    </TableRow>
                    <TableRow
                        android:id="@+id/city_tab"
                        android:background="#f0f0f0"
                        android:layout_margin="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_column="0"
                            android:text="@string/city" />

                        <TextView
                            android:id="@+id/city"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="2"
                            android:layout_weight="1" />
                    </TableRow>
                    <TableRow
                        android:id="@+id/region_tab"
                        android:background="#f0f0f0"
                        android:layout_margin="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_column="0"
                            android:text="@string/region" />

                        <TextView
                            android:id="@+id/region"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="2"
                            android:layout_weight="1" />
                    </TableRow>
                    <TableRow
                        android:id="@+id/country_tab"
                        android:background="#f0f0f0"
                        android:layout_margin="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_column="0"
                            android:text="@string/country" />
                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:layout_column="1"
                            />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="2"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:orientation="horizontal">
                            <ImageView
                                android:id="@+id/country_flag"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/icon_72x72" />
                            <TextView
                                android:layout_marginStart="5dp"
                                android:id="@+id/country"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="5dp"
                                android:background="#A9A9A9" />

                            <TextView
                                android:id="@+id/country_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </TableRow>
                    <TableRow
                        android:id="@+id/in_eu_tab"
                        android:background="#f0f0f0"
                        android:layout_margin="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_column="0"
                            android:text="@string/in_eu" />

                        <TextView
                            android:id="@+id/in_eu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="2"
                            android:layout_weight="1" />
                    </TableRow>
                    <TableRow
                        android:id="@+id/position_tab"
                        android:background="#f0f0f0"
                        android:layout_margin="1dp"
                        >

                        <TextView
                            android:layout_column="0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/position" />

                        <TextView
                            android:layout_column="2"
                            android:id="@+id/latitude"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </TableRow>
                    <TableRow
                        android:id="@+id/longitude_tab"
                        android:visibility="gone"
                        android:background="#f0f0f0"
                        android:layout_margin="1dp">

                        <TextView
                            android:layout_column="0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/longitude" />

                        <TextView
                            android:layout_column="2"
                            android:id="@+id/longitude"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </TableRow>
                    <TableRow
                        android:id="@+id/timezone_tab"
                        android:background="#f0f0f0"
                        android:layout_margin="1dp"
                        >

                        <TextView
                            android:layout_column="0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/timezone" />

                        <TextView
                            android:layout_column="2"
                            android:id="@+id/timezone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </TableRow>
                    <TableRow
                        android:id="@+id/country_calling_code_tab"
                        android:background="#f0f0f0"
                        android:layout_margin="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_column="0"
                            android:text="@string/country_calling_code" />

                        <TextView
                            android:id="@+id/country_calling_code"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="2"
                            android:layout_weight="1" />
                    </TableRow>
                    <TableRow
                        android:id="@+id/currency_tab"
                        android:background="#f0f0f0"
                        android:layout_margin="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_column="0"
                            android:text="@string/currency" />

                        <TextView
                            android:id="@+id/currency"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="2"
                            android:layout_weight="1" />
                    </TableRow>
                    <TableRow
                        android:id="@+id/languages_tab"
                        android:background="#f0f0f0"
                        android:layout_margin="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_column="0"
                            android:text="@string/languages" />

                        <TextView
                            android:id="@+id/languages"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="2"
                            android:layout_weight="1" />
                    </TableRow>
                    <TableRow
                        android:id="@+id/asn_tab"
                        android:background="#f0f0f0"
                        android:layout_margin="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_column="0"
                            android:text="@string/asn" />

                        <TextView
                            android:id="@+id/asn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="2"
                            android:layout_weight="1" />
                    </TableRow>
                    <TableRow
                        android:id="@+id/org_tab"
                        android:background="#f0f0f0"
                        android:layout_margin="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_column="0"
                            android:text="@string/org" />

                        <TextView
                            android:id="@+id/org"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="2"
                            android:layout_weight="1" />
                    </TableRow>
                    <LinearLayout
                        android:id="@+id/region_code_tab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/region_code" />

                        <TextView
                            android:id="@+id/region_code"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/country_code_tab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/country_code" />

                        <TextView
                            android:id="@+id/country_code"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/country_code_iso3_tab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/country_code_iso3" />

                        <TextView
                            android:id="@+id/country_code_iso3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/country_name_tab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/country_name" />

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/country_capital_tab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/country_capital" />

                        <TextView
                            android:id="@+id/country_capital"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/country_tld_tab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/country_tld" />

                        <TextView
                            android:id="@+id/country_tld"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/country_area_tab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/country_area" />

                        <TextView
                            android:id="@+id/country_area"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/country_population_tab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/country_population" />

                        <TextView
                            android:id="@+id/country_population"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/continent_code_tab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/continent_code" />

                        <TextView
                            android:id="@+id/continent_code"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/postal_tab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/postal" />

                        <TextView
                            android:id="@+id/postal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/latlong_tab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/latlong" />

                        <TextView
                            android:id="@+id/latlong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/utc_offset_tab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/utc_offset" />

                        <TextView
                            android:id="@+id/utc_offset"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/currency_name_tab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/currency_name" />

                        <TextView
                            android:id="@+id/currency_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>
                </TableLayout>
            </androidx.cardview.widget.CardView>




        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

<!--    <com.startapp.sdk.ads.banner.Banner android:visibility="visible" android:id="@+id/startAppBanner" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true" android:layout_alignParentBottom="true"/>-->

</RelativeLayout>